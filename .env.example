# SyLoc – Exemple de variables d'environnement
# Copier en .env et remplir selon l'environnement (ne pas commiter .env)

# Django
DJANGO_SECRET_KEY=change-me-en-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de données (optionnel ; par défaut SQLite)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Cache / rate limit (optionnel ; par défaut cache mémoire)
# REDIS_URL=redis://localhost:6379/0

# HTTPS / CSRF (prod)
# RENDER_EXTERNAL_URL=https://votre-app.onrender.com
# ou CSRF_TRUSTED_ORIGINS=https://votre-domaine.com

# Stripe (abonnements Premium)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRODUCT_ID_BASE=prod_...   (référence produit Basic mensuel, optionnel)
# STRIPE_PRICE_ID_BASE=price_...   (basic mensuel)
# STRIPE_PRODUCT_ID_BASE_ANNUAL=prod_...   (référence produit Basic annuel, optionnel)
# STRIPE_PRICE_ID_BASE_ANNUAL=price_...   (basic annuel — ID utilisé par Checkout / abonnements)
# STRIPE_PRICE_ID_PREMIUM=price_...   (ou renseigner stripe_price_id sur le plan Premium en admin)
# STRIPE_PRODUCT_ID_PREMIUM_ANNUAL=prod_...   (référence produit Premium annuel, optionnel)
# STRIPE_PRICE_ID_PREMIUM_ANNUAL=price_...   (Premium annuel — ID utilisé par Checkout / abonnements)
#
# Après mise à jour des price_… dans Stripe : copier les mêmes IDs dans le .env ci-dessus, puis lancer
#   python manage.py sync_plan_stripe_prices
# pour mettre à jour les offres en base (admin Django). Option --dry-run pour prévisualiser.

# IA – Recommandations rentabilité (Premium) : sans clé, analyse par règles uniquement
# 1. Créer une clé sur https://platform.openai.com/api-keys
# 2. Définir OPENAI_API_KEY (et optionnellement OPENAI_MODEL)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Email – signatures électroniques, quittances, relances, rappels
# Dès que EMAIL_HOST est rempli, les vrais mails sont envoyés. Sinon : affichage en console.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=votre@email.com
# EMAIL_HOST_PASSWORD=mot-de-passe-application
# DEFAULT_FROM_EMAIL=noreply@votre-domaine.com

# Informations légales affichées sur les pages Mentions légales / confidentialité (production)
# SYLOC_LEGAL_PUBLISHER=Ma société SAS
# SYLOC_LEGAL_SIRET=123 456 789 00012
# SYLOC_LEGAL_ADDRESS=10 rue Exemple, 75000 Paris
# SYLOC_LEGAL_CONTACT_EMAIL=contact@votre-domaine.com
# SYLOC_LEGAL_HOSTING_PROVIDER=Render
